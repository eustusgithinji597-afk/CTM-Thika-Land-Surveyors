# =============================================================================
# Supabase Project Configuration
# =============================================================================
# Instructions:
# 1. Create a new Supabase project at https://supabase.com
# 2. Copy your project's values below (replace [YOUR_...] placeholders)
# 3. Run the SQL migration from supabase/migrations/001_init_schema.sql
#    in the Supabase SQL Editor to create the database tables
# =============================================================================

# Database connection (get from Supabase Dashboard > Project Settings > Database)
# Use the transaction pooler (port 6543) for serverless environments
DATABASE_URL=postgresql://postgres.kpaznpacribclcjhpnnh:[YOUR_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase API (get from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://kpaznpacribclcjhpnnh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# =============================================================================
# App Settings
# =============================================================================

# WhatsApp number for lead notifications
NEXT_PUBLIC_WHATSAPP_NUMBER=254769311896

# API URL (change in production)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Better Auth (generate a random secret: openssl rand -hex 32)
BETTER_AUTH_SECRET=[GENERATE_A_LONG_RANDOM_SECRET]

# NextAuth URL (change in production)
NEXTAUTH_URL=http://localhost:3000